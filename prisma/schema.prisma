// Fikr Quran Academy Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ADMIN USER
// ─────────────────────────────────────────────────────────────────────────────

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// REGISTRATION / ENROLLMENT
// ─────────────────────────────────────────────────────────────────────────────

model Registration {
  id                String   @id @default(cuid())
  applicationId     String   @unique // e.g., FQ-2026-0001
  
  // Student Information
  fullName          String
  parentName        String?
  email             String
  phone             String
  country           String
  state             String?
  gender            String
  dateOfBirth       String?
  
  // Programme Details
  experience        String
  programme         String
  frequency         String   // twice-weekly, three-times-weekly, four-times-weekly
  sessionsPerMonth  Int
  days              String   // JSON array of selected days
  time              String
  timezone          String?
  
  // Pricing & Payment
  currency          String   // NGN or USD
  amount            Int      // Amount in smallest unit (kobo/cents)
  paymentStatus     String   @default("PENDING") // PENDING, PROCESSING, PAID, FAILED, CANCELLED
  paymentReference  String?
  paymentVerifiedAt DateTime?
  
  // Metadata
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([paymentStatus])
  @@index([country])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// CONTACT MESSAGES
// ─────────────────────────────────────────────────────────────────────────────

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  status    String   @default("UNREAD") // UNREAD, READ, ARCHIVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([status])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// TESTIMONIALS
// ─────────────────────────────────────────────────────────────────────────────

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  country   String
  text      String
  rating    Int      @default(5)
  image     String?
  published Boolean  @default(false)
  order     Int      @default(0) // For manual ordering
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([published])
  @@index([order])
}

// ─────────────────────────────────────────────────────────────────────────────
// BLOG POSTS
// ─────────────────────────────────────────────────────────────────────────────

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String    // Rich text content
  coverImage  String?
  author      String
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([published])
  @@index([publishedAt])
  @@index([slug])
}

// ─────────────────────────────────────────────────────────────────────────────
// EMAIL CAMPAIGNS
// ─────────────────────────────────────────────────────────────────────────────

model EmailLog {
  id            String    @id @default(cuid())
  sender        String    // Admin email
  recipientType String    // all-paid, all-registered, selected, individual
  recipient     String    // Email address or identifier
  subject       String
  body          String
  status        String    @default("PENDING") // PENDING, SENT, FAILED
  sentAt        DateTime?
  errorMessage  String?
  createdAt     DateTime  @default(now())
  
  @@index([status])
  @@index([createdAt])
}
